# ==============================================================================
# Tantu Frontend Environment Configuration (.env.example)
# ==============================================================================
# Copy this file to `frontend/.env.local` for local Next.js frontend development.
# Run `npm run dev:frontend` or `npm run dev` from the repository root.

# ------------------------------------------------------------------------------
# Backend API Server Location
# ------------------------------------------------------------------------------
# The internal URL of the Fastify backend server.
# Next.js route handlers and server proxies forward `/api/v1/*` requests to this origin.
# Default development backend port is 4000 on localhost.
BACKEND_ORIGIN=http://127.0.0.1:4000
