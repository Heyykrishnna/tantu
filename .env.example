# ==============================================================================
# Tantu Monorepo Full-Stack Environment Configuration (.env.example)
# ==============================================================================
# This template documents all environment variables used across Tantu services
# (Next.js Frontend, Fastify Backend, Database Migrations, and Background Worker).
#
# Quick setup for local development:
#   cp .env.example .env
#   cp backend/.env.example backend/.env
#   cp frontend/.env.example frontend/.env.local
#   docker compose up -d postgres scanner
#   npm run migrate
#   npm run dev

# ------------------------------------------------------------------------------
# 1. Server Environment & Network
# ------------------------------------------------------------------------------
# Execution environment: "development", "test", or "production"
NODE_ENV=development

# Host interface to bind Fastify HTTP server (127.0.0.1 for local isolation)
HOST=127.0.0.1

# Port for Fastify HTTP server (default 4000)
PORT=4000

# Logging severity: "fatal", "error", "warn", "info", "debug", "trace"
LOG_LEVEL=info

# Canonical public origin of the Next.js frontend (used for CORS and CSRF checks)
APP_ORIGIN=http://localhost:3000

# Frontend origin targeting the Fastify backend for proxying /api/v1/*
BACKEND_ORIGIN=http://127.0.0.1:4000

# ------------------------------------------------------------------------------
# 2. Database Connection
# ------------------------------------------------------------------------------
# Primary application connection string (runtime user role with restricted privileges)
DATABASE_URL=postgresql://tantu_runtime:password@localhost:5432/tantu

# Migration database connection string (owner/admin role with DDL privileges)
# Note for Neon users: Must use direct unpooled connection for migrations
MIGRATION_DATABASE_URL=postgresql://tantu_owner:password@localhost:5432/tantu

# ------------------------------------------------------------------------------
# 3. File Storage & Cryptographic Keys
# ------------------------------------------------------------------------------
# Local directory path where uploaded files and attachments are stored on disk
FILE_STORAGE_PATH=/tmp/tantu-files

# 64-character hex secret for signing time-limited file download URLs (HMAC-SHA256)
# Generate with: openssl rand -hex 32
FILE_SIGNING_SECRET=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# 64-character hex secret for encrypting third-party OAuth access tokens at rest (AES-GCM)
# Generate with: openssl rand -hex 32
PROVIDER_VAULT_KEY=fedcba9876543210fedcba9876543210fedcba9876543210fedcba9876543210

# ------------------------------------------------------------------------------
# 4. Antivirus Malware Scanner (ClamAV daemon)
# ------------------------------------------------------------------------------
# ClamAV daemon hostname or container name
SCANNER_HOST=127.0.0.1

# ClamAV daemon port (standard 3310)
SCANNER_PORT=3310

# ------------------------------------------------------------------------------
# 5. Third-Party Integrations (Optional in local development)
# ------------------------------------------------------------------------------
# Google OAuth 2.0 Credentials (for Google Calendar & Gmail integration)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Microsoft Azure OAuth 2.0 Credentials (for Outlook & Exchange integration)
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common

# Public HTTPS origin for incoming webhooks (e.g. ngrok HTTPS tunnel)
PROVIDER_NOTIFICATION_ORIGIN=

# Google Cloud Pub/Sub configuration for push calendar event webhooks
GOOGLE_PUBSUB_TOPIC=
GOOGLE_PUBSUB_AUDIENCE=
GOOGLE_PUBSUB_SERVICE_EMAIL=
GOOGLE_PUBSUB_SUBSCRIPTION=
