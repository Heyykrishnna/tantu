{
  "name": "@tantu/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "TypeScript and Fastify application foundation for tantu.",
  "engines": {
    "node": ">=24.0.0 <25",
    "npm": ">=11.0.0 <12"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx --watch src/server.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "build": "tsc --project tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "migrate": "node --env-file-if-exists=.env --import tsx scripts/migrate.ts",
    "test:integration": "node --import tsx --test test/integration/*.test.ts",
    "bootstrap": "node --env-file-if-exists=.env --import tsx scripts/bootstrap.ts",
    "worker": "node --env-file-if-exists=.env --import tsx src/workers/server.ts",
    "start:worker": "node --env-file-if-exists=.env dist/workers/server.js",
    "contracts:types": "node scripts/export-types.mjs",
    "contracts:check": "node scripts/export-types.mjs --check"
  },
  "dependencies": {
    "@fastify/helmet": "13.2.0",
    "fastify": "5.12.7",
    "pg": "8.23.1",
    "pg-boss": "12.30.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "^24.0.0",
    "@types/pg": "8.20.0",
    "eslint": "10.13.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1"
  }
}
