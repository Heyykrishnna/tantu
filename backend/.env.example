# ==============================================================================
# Tantu Backend Environment Configuration (.env.example)
# ==============================================================================
# Copy this file to `backend/.env` for local backend development.
# Run `npm run dev:backend` or `npm run dev` from the repository root.

# ------------------------------------------------------------------------------
# 1. Server Environment & Network
# ------------------------------------------------------------------------------
# Runtime environment: "development", "test", or "production"
NODE_ENV=development

# Host interface to bind Fastify HTTP server (127.0.0.1 for local security)
HOST=127.0.0.1

# Port for Fastify HTTP server (default 4000)
PORT=4000

# Logging severity: "fatal", "error", "warn", "info", "debug", "trace"
LOG_LEVEL=info

# Canonical origin of the Next.js frontend application (used for CORS and CSRF verification)
APP_ORIGIN=http://localhost:3000

# ------------------------------------------------------------------------------
# 2. PostgreSQL Database Connection
# ------------------------------------------------------------------------------
# Primary application database URL (runtime user role with restricted permissions)
# Format: postgresql://<user>:<password>@<host>:<port>/<dbname>[?sslmode=require]
# Local Docker Postgres default:
DATABASE_URL=postgresql://tantu_runtime:password@localhost:5432/tantu

# Migration database connection URL (migration runner role with DDL permissions)
# If using Neon: use direct unpooled endpoint for migrations, pooled endpoint for DATABASE_URL
MIGRATION_DATABASE_URL=postgresql://tantu_owner:password@localhost:5432/tantu

# ------------------------------------------------------------------------------
# 3. File Storage & Cryptographic Secrets
# ------------------------------------------------------------------------------
# Local disk directory path where uploaded record files and attachments are stored
FILE_STORAGE_PATH=/tmp/tantu-files

# 64-character hex secret for signing time-limited file download URLs (HMAC)
# Generate with: openssl rand -hex 32
FILE_SIGNING_SECRET=

# 64-character hex secret key for AES-GCM encryption of OAuth tokens at rest
# Generate with: openssl rand -hex 32
PROVIDER_VAULT_KEY=

# ------------------------------------------------------------------------------
# 4. Antivirus Malware Scanner (ClamAV daemon)
# ------------------------------------------------------------------------------
# Host of the clamd virus scanning container/daemon
SCANNER_HOST=127.0.0.1

# Port of clamd daemon (standard TCP port 3310)
SCANNER_PORT=3310

# ------------------------------------------------------------------------------
# 5. Google Workspace Integration (Calendar & Gmail) - Optional in dev
# ------------------------------------------------------------------------------
# OAuth 2.0 Client ID from Google Cloud Console (Credentials -> OAuth 2.0 Client IDs)
GOOGLE_CLIENT_ID=

# OAuth 2.0 Client Secret from Google Cloud Console
GOOGLE_CLIENT_SECRET=

# Public HTTPS origin for receiving webhook notifications from providers (e.g. ngrok tunnel)
PROVIDER_NOTIFICATION_ORIGIN=

# Google Cloud Pub/Sub topic and audience for push notification webhooks
GOOGLE_PUBSUB_TOPIC=
GOOGLE_PUBSUB_AUDIENCE=
GOOGLE_PUBSUB_SERVICE_EMAIL=
GOOGLE_PUBSUB_SUBSCRIPTION=

# ------------------------------------------------------------------------------
# 6. Microsoft 365 Integration (Outlook & Calendar) - Optional in dev
# ------------------------------------------------------------------------------
# Azure Active Directory Application (Client) ID
MICROSOFT_CLIENT_ID=

# Azure Active Directory Client Secret Value
MICROSOFT_CLIENT_SECRET=

# Azure Active Directory Directory (Tenant) ID or "common" for multi-tenant
MICROSOFT_TENANT_ID=common
