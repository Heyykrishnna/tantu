  "cards": [
    {
      "dot": "cyan",
      "title": "Canonical write contract",
      "items": [
        "This flow covers task/page canonical mutations, not every registered module or provider side effect.",
        "A replay returns the original durable result only for an identical operation fingerprint and current record access. Changed payloads cannot reuse the same operation ID."
      ]
    },
    {
      "dot": "emerald",
      "title": "Atomicity and concurrency",
      "items": [
        "An advisory transaction lock serializes the operation key; current membership and row access are checked. Existing-record edits lock the row and compare expectedVersion.",
        "The record change, operation result, revision (for non-deletes), canonical event and queued job share the same PostgreSQL transaction. Errors roll it back."
      ]
    },
    {
      "dot": "rose",
      "title": "Authorization still applies after enqueue",
      "items": [
        "The worker validates the envelope, fences attempts with a token and locks the active job before applying effects.",
        "Event publication rechecks current membership and readable record access. Revoked or unreadable work is marked discarded, not published; acknowledgement commits with that checkpoint."
      ]
    },
    {
      "dot": "amber",
      "title": "Retry boundaries",
      "items": [
        "Internal job failures retry with bounded backoff, then dead-letter. A lost HTTP acknowledgement is recovered with the original operation ID.",
        "Provider sends and external effects have separate committed uncertainty handling. This internal-event flow must not be read as permission to retry remote sends blindly."
      ]
    },
    {
      "dot": "slate",
      "title": "Repository evidence",
      "items": [
        "Source links are pinned to 4739adf6a360658bf57fb3e792b685dea42f9d2c. Working-tree UI and invitation changes are outside this committed canonical-save slice.",
        "No network calls, real provider sends, deployment or production certification are implied by this diagram."
      ]
    }
  ]
